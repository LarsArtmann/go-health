#!/usr/bin/env bash
# Toolchain pin for BuildFlow's license-check step (referenced by
# .buildflow.yml tool_paths). BuildFlow's full mode can spawn go-licenses
# without the configured GOTOOLCHAIN=auto env (2026-10-09: 8 steps red with
# "running go 1.27.0" while single-step with the same config passed), and the
# tools/doanalyzerv2 graph requires go 1.27.1 (branching-flow replace). Force
# the switch and re-export the ACTIVE go's GOROOT so stdlib classification
# matches the go list invocation (go-licenses v1.6.0 prefix-matches the
# build-time GOROOT). Drop this wrapper when BuildFlow's closure go meets the
# graph floor and full-mode env propagation is verified.
export GOTOOLCHAIN=auto
active_goroot="$(/run/current-system/sw/bin/go env GOROOT 2>/dev/null)" &&
    [ -n "$active_goroot" ] &&
    export GOROOT="$active_goroot"
exec /home/lars/.local/bin/go-licenses.real "$@"
